---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import LimitationItem from '../components/LimitationItem.astro';
import {
  advantages,
  limitations,
  providerFinePrint,
  smallerAdvantages,
  supportedProviders,
} from '../comparisonData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const inlineLinkClass = 'text-accent underline underline-offset-4 hover:no-underline';
---

<BaseLayout
  title="MailSimple – alle Postfächer in einer App, ohne Umweg"
  description="MailSimple bündelt deine E-Mail-Konten auf dem iPhone. Ohne Umweg über andere Firmen, ohne Werbung. Mit Vergleich zu Apple Mail, Gmail, Outlook, Spark, GMX, WEB.DE und Telekom Mail."
>
  <section aria-labelledby="hero-heading" class="flex flex-col items-start gap-6">
    <img src={`${base}/app-icon.png`} alt="App-Symbol von MailSimple" width="96" height="96" class="rounded-[22px]" />
    <h1 id="hero-heading" class="font-display text-4xl leading-tight font-bold tracking-tight text-balance sm:text-5xl">
      Deine Post bleibt zwischen dir und deinem Anbieter.
    </h1>
    <p class="max-w-prose text-xl leading-relaxed text-text-muted">
      MailSimple ist eine Mail-App für das iPhone. Sie holt deine E-Mails direkt von Gmail, GMX, WEB.DE, iCloud und
      anderen. Ohne Umweg über andere Firmen. Zurzeit kostenlos und ohne Werbung.
    </p>
  </section>

  <section aria-labelledby="advantages-heading" class="mt-20">
    <h2 id="advantages-heading" class="font-display text-3xl font-bold tracking-tight">Was MailSimple anders macht</h2>
    <ul class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        advantages.map((advantage) => (
          <li class="border-l-4 border-accent pl-5">
            <h3 class="font-display text-xl font-semibold">{advantage.title}</h3>
            <p class="mt-2 text-lg leading-relaxed">{advantage.text}</p>
          </li>
        ))
      }
    </ul>
    <h3 class="mt-12 font-display text-xl font-semibold">Außerdem</h3>
    <ul class="mt-3 list-disc pl-6 text-lg leading-relaxed marker:text-text-muted">
      {smallerAdvantages.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="providers-heading" class="mt-20">
    <h2 id="providers-heading" class="font-display text-3xl font-bold tracking-tight">Diese Postfächer funktionieren</h2>
    <ul class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-4" aria-label="Anbieter, die MailSimple selbst einrichtet">
      {
        supportedProviders.map((provider) => (
          <li class="flex items-center gap-2 text-lg font-medium">
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-positive"
            >
              <path d="M4 10.5l4 4 8-9" />
            </svg>
            {provider}
          </li>
        ))
      }
    </ul>
    <p class="mt-6 max-w-prose text-lg leading-relaxed">
      Bei diesen Anbietern trägt MailSimple alles selbst ein. Du gibst nur deine E-Mail-Adresse und dein Passwort ein.
      Auch die meisten anderen Anbieter funktionieren. Dann sucht die App die Einstellungen selbst oder du trägst sie von
      Hand ein.
    </p>
    <div class="mt-8 flex flex-col gap-4 border-t border-border pt-6 text-base leading-relaxed text-text-muted">
      {
        providerFinePrint.map((item) => (
          <div>
            <h3 class="font-semibold text-text">{item.title}</h3>
            <p class="mt-1 max-w-prose">
              {item.text}
              {item.source && (
                <>
                  {' '}
                  <a href={item.source.url} class={inlineLinkClass}>
                    Quelle: {item.source.label}
                  </a>
                </>
              )}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="comparison-heading" class="mt-20 lg:-mx-28 xl:-mx-40">
    <h2 id="comparison-heading" class="font-display text-3xl font-bold tracking-tight">MailSimple und andere Mail-Apps</h2>
    <p class="mt-4 max-w-prose text-lg leading-relaxed text-text-muted">
      Auf einen Blick. Unter der Tabelle findest du zu jeder App Erklärungen und Links zum Nachlesen.
    </p>
    <div class="mt-8">
      <ComparisonTable />
    </div>
  </section>

  <section aria-labelledby="limitations-heading" class="mt-20 rounded-3xl bg-surface-accent px-5 py-10 sm:px-10">
    <h2 id="limitations-heading" class="font-display text-3xl font-bold tracking-tight">
      Was MailSimple nicht kann – und warum
    </h2>
    <p class="mt-4 text-lg leading-relaxed">
      In manchen Dingen sind die großen Apps weiter. Das solltest du wissen, bevor du MailSimple ausprobierst.
    </p>
    <ul class="mt-8 flex flex-col gap-5 text-lg leading-relaxed">
      {limitations.map((limitation) => <LimitationItem limitation={limitation} />)}
    </ul>
  </section>

  <section aria-labelledby="help-heading" class="mt-20">
    <h2 id="help-heading" class="font-display text-3xl font-bold tracking-tight">Fragen?</h2>
    <p class="mt-4 text-lg leading-relaxed">
      Hilfe beim Einrichten findest du auf der <a href={`${base}/support/`} class={inlineLinkClass}>Support-Seite</a>.
      Wie MailSimple mit deinen Daten umgeht, steht in der <a href={`${base}/datenschutz/`} class={inlineLinkClass}
        >Datenschutzerklärung</a
      >.
    </p>
  </section>
</BaseLayout>
