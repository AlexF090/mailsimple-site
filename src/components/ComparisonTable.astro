---
import VerdictMark from './VerdictMark.astro';
import { comparedApps, comparisonCheckedOn, comparisonRows } from '../comparisonData';

const explanationsByApp = comparedApps.map((app) => ({
  app,
  explanations: comparisonRows
    .map((row) => ({ row, cell: row.cells[app.identifier] }))
    .filter(({ cell }) => cell.note !== undefined || cell.source !== undefined),
}));
---

<div
  role="region"
  aria-labelledby="comparison-caption"
  tabindex="0"
  class="overflow-x-auto rounded-2xl border border-border"
>
  <table class="w-full min-w-[50rem] border-collapse text-left text-base">
    <caption id="comparison-caption" class="sr-only">Mail-Apps im Vergleich, Stand {comparisonCheckedOn}</caption>
    <thead>
      <tr class="border-b border-border">
        <th scope="col" class="sticky left-0 z-10 bg-surface p-3 align-bottom font-display text-lg sm:p-4">
          Frage
        </th>
        {
          comparedApps.map((app) => (
            <th
              scope="col"
              class:list={[
                'p-3 align-bottom font-display text-lg sm:p-4',
                app.identifier === 'mailSimple' && 'bg-surface-accent',
              ]}
            >
              {app.name}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        comparisonRows.map((row) => (
          <tr class="border-b border-border last:border-b-0">
            <th scope="row" class="sticky left-0 z-10 w-36 bg-surface p-3 align-top font-medium sm:w-56 sm:p-4">
              {row.question}
            </th>
            {comparedApps.map((app) => (
              <td class:list={['p-3 align-top sm:p-4', app.identifier === 'mailSimple' && 'bg-surface-accent']}>
                <VerdictMark verdict={row.cells[app.identifier].verdict} />
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="mt-3 text-base text-text-muted lg:hidden">Auf dem Handy: Tabelle zur Seite wischen, um alle Apps zu sehen.</p>

<h3 class="mt-12 font-display text-xl font-semibold">Erklärungen und Quellen</h3>
<p class="mt-2 max-w-prose text-base leading-relaxed text-text-muted">
  Alles über andere Apps stammt von den Herstellern selbst: Hilfeseiten, Preisseiten oder App Store. „Keine Angabe“
  heißt: Der Hersteller sagt dazu nichts Eindeutiges. Stand: {comparisonCheckedOn}.
</p>
<div class="mt-4 flex flex-col border-t border-border">
  {
    explanationsByApp.map(({ app, explanations }) => (
      <details class="group border-b border-border">
        <summary class="flex min-h-11 cursor-pointer list-none items-center [&::-webkit-details-marker]:hidden justify-between gap-4 py-3 font-display text-lg font-semibold">
          {app.name}
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="shrink-0 text-text-muted transition-transform group-open:rotate-180 motion-reduce:transition-none"
          >
            <path d="M5 7.5l5 5 5-5" />
          </svg>
        </summary>
        <dl class="flex flex-col gap-4 pb-6 text-base leading-relaxed">
          {explanations.map(({ row, cell }) => (
            <div>
              <dt class="font-semibold">{row.question}</dt>
              <dd class="mt-1">
                {cell.note}
                {cell.source && (
                  <>
                    {' '}
                    <a href={cell.source.url} class="text-accent underline underline-offset-4 hover:no-underline">
                      Quelle: {cell.source.label}
                      <span class="sr-only">
                        zu {app.name}, {row.question}
                      </span>
                    </a>
                  </>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </details>
    ))
  }
</div>
