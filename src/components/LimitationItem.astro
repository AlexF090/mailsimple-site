---
import type { Limitation } from '../comparisonData';

interface Props {
  limitation: Limitation;
}

const { limitation } = Astro.props;
---

<li class="rounded-2xl bg-surface p-6">
  <h3 class="font-display text-xl font-semibold">{limitation.title}</h3>
  <p class="mt-3 font-medium">{limitation.shortAnswer}</p>
  <p class="mt-3">
    <span class="font-semibold">Warum? </span>{limitation.reason}
  </p>
  {
    limitation.sources.map((source) => (
      <a
        href={source.url}
        class="mt-2 mr-6 inline-flex min-h-11 items-center text-base text-accent underline underline-offset-4 hover:no-underline"
      >
        Quelle: {source.label}
      </a>
    ))
  }
  {limitation.isPlanned && <p class="mt-3 font-semibold text-accent-secondary">Ist in Planung.</p>}
</li>
