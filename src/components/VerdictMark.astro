---
import type { Verdict } from '../comparisonData';

interface Props {
  verdict: Verdict;
}

const { verdict } = Astro.props;

const presentation = {
  yes: { label: 'Ja', colorClass: 'text-positive' },
  no: { label: 'Nein', colorClass: 'text-negative' },
  partly: { label: 'Teilweise', colorClass: 'text-partial' },
  unknown: { label: 'Keine Angabe', colorClass: 'text-text-muted' },
}[verdict];
---

<span class:list={['inline-flex items-center gap-1.5 font-semibold', presentation.colorClass]}>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20" class="shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    {verdict === 'yes' && <path d="M4 10.5l4 4 8-9" />}
    {verdict === 'no' && <path d="M5 5l10 10M15 5L5 15" />}
    {
      verdict === 'partly' && (
        <>
          <circle cx="10" cy="10" r="7" />
          <path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor" stroke="none" />
        </>
      )
    }
    {verdict === 'unknown' && <path d="M5 10h10" />}
  </svg>
  {presentation.label}
</span>
