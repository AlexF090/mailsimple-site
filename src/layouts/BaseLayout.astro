---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navigationLinks = [
  { href: `${base}/`, label: 'Start' },
  { href: `${base}/support/`, label: 'Support' },
  { href: `${base}/datenschutz/`, label: 'Datenschutz' },
];
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}/app-icon.png`} />
    <title>{title}</title>
  </head>
  <body class="bg-surface text-text antialiased">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-surface-raised focus:p-3"
      >Zum Inhalt springen</a
    >
    <header class="border-b border-border">
      <nav
        aria-label="Hauptnavigation"
        class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-6 py-4"
      >
        <a href={`${base}/`} class="flex min-h-11 items-center gap-3 font-semibold">
          <img src={`${base}/app-icon.png`} alt="" width="36" height="36" class="rounded-lg" />
          MailSimple
        </a>
        <ul class="flex flex-wrap gap-2">
          {
            navigationLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={currentPath === link.href ? 'page' : undefined}
                  class="flex min-h-11 items-center rounded-md px-3 text-text-muted hover:text-text aria-[current=page]:font-semibold aria-[current=page]:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="inhalt" class="mx-auto max-w-3xl px-6 py-12">
      <slot />
    </main>
    <footer class="border-t border-border">
      <p class="mx-auto max-w-3xl px-6 py-6 text-sm text-text-muted">
        MailSimple ist ein privates, kostenloses Projekt von Alexander Fischenich.
      </p>
    </footer>
  </body>
</html>
